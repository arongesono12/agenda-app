# Opcional: identifica el proyecto, pero no sustituye OAuth 2.0.
GOOGLE_MEET_API_KEY=your-google-api-key

# Metodo 1: OAuth de una cuenta organizadora.
GOOGLE_MEET_CLIENT_ID=your-google-oauth-client-id
GOOGLE_MEET_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_MEET_REFRESH_TOKEN=your-google-oauth-refresh-token

# Metodo 2: cuenta de servicio con delegacion de dominio (alternativo al metodo 1).
GOOGLE_MEET_SERVICE_ACCOUNT_EMAIL=meet-service@your-project.iam.gserviceaccount.com
GOOGLE_MEET_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_MEET_IMPERSONATED_USER=organizador@your-domain.com

# OPEN permite acceder con el enlace; tambien admite TRUSTED o RESTRICTED.
GOOGLE_MEET_ACCESS_TYPE=OPEN

